# Copy this file to .env.local and fill in real values. Never commit .env.local.

# SQLite for local dev (default). Swap for a Postgres URL when ready for
# staging/production — see Section 7 of the build plan.
DATABASE_URL="file:./dev.db"

# Required for Section 6's AI/agentic features (conversational intake,
# proactive follow-up, document pre-screening, pattern-detection digest,
# multilingual sync). Without this, src/lib/gemini.ts throws a clear error
# instead of silently doing nothing — the rest of the app works fine without it.
GEMINI_API_KEY=

# Required to sign in to the internal review tools (/admin/login): story and
# petition approval, follow-up escalation sending, and gazette re-scraping.
# Without both of these set, /api/admin/login returns 503 and those routes
# stay unreachable (proxy.ts and each route handler both require a valid
# session — there's no way in without them). Generate ADMIN_SESSION_SECRET
# with `openssl rand -hex 32` or similar; never reuse the example value.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
